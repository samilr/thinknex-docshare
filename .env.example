# Copiar a .env (cp .env.example .env). Valores SOLO para desarrollo local con datos ficticios.
# En cualquier ambiente real estos valores vienen de un gestor de secretos (Vault, AWS SM, etc.).

# --- Postgres ---------------------------------------------------------------
POSTGRES_USER=thinknex
POSTGRES_PASSWORD=thinknex-local-dev
POSTGRES_DB=share

# --- Almacenamiento S3 compatible (SeaweedFS en local) ------------------------
S3_ACCESS_KEY=thinknex-s3-local
S3_SECRET_KEY=thinknex-s3-local-dev-secret

# --- document-api (DMS simulado) ---------------------------------------------
DMS_API_KEY=dms-local-dev-key-change-me

# --- share-api ---------------------------------------------------------------
# Generar con: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=local-dev-jwt-secret-change-me-0123456789abcdef
OTP_SECRET=local-dev-otp-secret-change-me-0123456789abcdef
# Contraseña compartida del login de desarrollo (usuarios ficticios ana/bruno/carla@demo-corp.example)
DEV_LOGIN_PASSWORD=demo-password

# --- IA opcional: chequeo de sensibilidad asistido por LLM --------------------
SENSITIVITY_LLM_ENABLED=false
# ANTHROPIC_API_KEY=
